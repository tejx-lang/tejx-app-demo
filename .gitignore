# ==========================================
# TejX Demo - Git Ignore Rules
# ==========================================

# 1. Environment & Local Credentials
# (Keep .env.example files committed for reference)
.env
.env.*
*.env
!*.env.example
!.env.example
**/.env
**/.env.*
!**/.env.example

# 2. Node & Frontend Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# 3. Build & Distribution Outputs
dist/
**/dist/
build/
**/build/
.cache/
.vite/
**/vite.config.js.timestamp-*

# 4. TejX Native Compilations & Binaries
backend/build/
mongo-sdk/tests/test_bson
mongo-sdk/tests/test_client
*.o
*.a
*.so
*.dylib
*.out
*.exe

# 5. Database & Runtime Data
data/
**/data/
tmp/
**/tmp/
temp/
*.log
logs/

# 6. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 7. IDE & Editor Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
