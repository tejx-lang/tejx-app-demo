// Dashboard backend-driven configuration handler
import { AppHttpResponse, AppRouteContext } from "../../../server/index.tx";
import { JsonObject, objectOf, parseJson } from "../../helpers/json.tx";
import { jsonSuccess, jsonError } from "../../core/responses.tx";
import { getAppState, AppState } from "../../core/state.tx";
import { MongoDatabase } from "../../../../../mongo-sdk/src/index.tx";
import { MongoJsonObject } from "../../../../../mongo-sdk/src/json.tx";
import { getStorageMode } from "../../core/persistence.tx";

let customTitle: string = "NomadOS | Digital Nomad Command Center";
let customDefaultCity: string = "Tokyo";
let customDefaultCountry: string = "Portugal";
let customDefaultCrypto: string = "bitcoin";
let customPinnedWidgets: string[] = ["weather", "crypto", "news", "backend"];

export function handleGetDashboardConfig(ctx: AppRouteContext): AppHttpResponse {
    let out: JsonObject = objectOf({});
    out.setString("title", customTitle);
    out.setString("subtitle", "Digital Nomad Command Center • Powered by Pure TejX & MongoDB");
    out.setString("defaultCity", customDefaultCity);
    out.setString("defaultCountry", customDefaultCountry);
    out.setString("defaultCrypto", customDefaultCrypto);
    out.setString("storageMode", getStorageMode());
    out.setStringArray("pinnedWidgets", customPinnedWidgets);

    // 1. Categories configuration
    let categoriesList: any[] = [
        { id: "all", label: "All Modules", icon: "🌐", count: 26 },
        { id: "travel", label: "Travel & Environment", icon: "✈️", count: 6 },
        { id: "finance", label: "Finance & Crypto", icon: "📈", count: 4 },
        { id: "productivity", label: "Productivity & Tools", icon: "⚡", count: 5 },
        { id: "health", label: "Health & Fitness", icon: "🥗", count: 3 },
        { id: "entertainment", label: "Cosmic & Zen", icon: "🪐", count: 7 },
        { id: "backend", label: "TejX + MongoDB Engine", icon: "⚡", count: 1 }
    ];
    out.setArray("categories", categoriesList);

    // 2. Dynamic Widget Manifest (all 26 widgets driven from backend)
    let widgetsList: any[] = [
        { id: "weather", title: "Current Weather", category: "travel", icon: "⛅", source: "Open-Meteo API", endpoint: "/api/data/weather", enabled: true },
        { id: "air_quality", title: "Air Quality Index", category: "travel", icon: "🍃", source: "Open-Meteo AQI", endpoint: "/api/data/air-quality", enabled: true },
        { id: "geolocation", title: "IP Geolocation", category: "travel", icon: "📍", source: "IP Geolocation", endpoint: "/api/data/geolocation", enabled: true },
        { id: "country", title: "Country Explorer", category: "travel", icon: "🗺️", source: "REST Countries", endpoint: "/api/data/country", enabled: true },
        { id: "world_clocks", title: "World Clocks", category: "travel", icon: "🕒", source: "Synchronized Clocks", endpoint: "/api/data/world-clocks", enabled: true },
        { id: "holidays", title: "Public Holidays", category: "travel", icon: "🎉", source: "Nager.Date", endpoint: "/api/data/holidays", enabled: true },
        { id: "crypto", title: "Live Crypto Benchmark", category: "finance", icon: "🪙", source: "CoinGecko", endpoint: "/api/data/crypto", enabled: true },
        { id: "exchange", title: "Currency Converter", category: "finance", icon: "💱", source: "Frankfurter Forex", endpoint: "/api/data/exchange", enabled: true },
        { id: "stocks", title: "Stock Watchlist", category: "finance", icon: "📊", source: "Tech Market Index", endpoint: "/api/data/stocks", enabled: true },
        { id: "sentiment", title: "Financial Sentiment Radar", category: "finance", icon: "🧭", source: "Fear & Greed Index", endpoint: "/api/data/sentiment", enabled: true },
        { id: "dictionary", title: "Free Dictionary", category: "productivity", icon: "📚", source: "Free Dictionary API", endpoint: "/api/data/dictionary", enabled: true },
        { id: "activity", title: "Daily Activity Idea", category: "productivity", icon: "💡", source: "Bored Activity API", endpoint: "/api/data/activity", enabled: true },
        { id: "qrcode", title: "QR Code Generator", category: "productivity", icon: "📱", source: "QR Server API", endpoint: "/api/data/qrcode", enabled: true },
        { id: "email_validator", title: "Email Domain Validator", category: "productivity", icon: "✉️", source: "Mail Domain Verifier", endpoint: "/api/data/validate-email", enabled: true },
        { id: "news", title: "Global Tech News", category: "productivity", icon: "📰", source: "HackerNews API", endpoint: "/api/data/news", enabled: true },
        { id: "recipe", title: "Recipe Explorer", category: "health", icon: "🍲", source: "TheMealDB", endpoint: "/api/data/recipe", enabled: true },
        { id: "macros", title: "Macro Nutrition Calculator", category: "health", icon: "🥗", source: "Nomad Nutritional Model", endpoint: "/api/data/macros", enabled: true },
        { id: "workout", title: "Hotel Workout Routine", category: "health", icon: "💪", source: "Nomad Calisthenics", endpoint: "/api/data/workout", enabled: true },
        { id: "nasa", title: "NASA Cosmic Picture", category: "entertainment", icon: "🔭", source: "NASA APOD API", endpoint: "/api/data/nasa-apod", enabled: true },
        { id: "quotes", title: "Nomad Motivation", category: "entertainment", icon: "💬", source: "ZenQuotes", endpoint: "/api/data/quotes", enabled: true },
        { id: "shows", title: "Trending Shows", category: "entertainment", icon: "🎬", source: "TVMaze API", endpoint: "/api/data/shows", enabled: true },
        { id: "gaming", title: "Gaming Releases Radar", category: "entertainment", icon: "🎮", source: "Gaming DB", endpoint: "/api/data/gaming", enabled: true },
        { id: "pokemon", title: "Pokémon Pokédex", category: "entertainment", icon: "⚡", source: "PokeAPI", endpoint: "/api/data/pokemon", enabled: true },
        { id: "anime", title: "Top Anime Schedule", category: "entertainment", icon: "🎌", source: "Jikan MyAnimeList", endpoint: "/api/data/anime", enabled: true },
        { id: "pets", title: "Pet Stress Relief", category: "entertainment", icon: "🐕", source: "Dog CEO API", endpoint: "/api/data/pets", enabled: true },
        { id: "backend", title: "TejX + MongoDB Engine", category: "backend", icon: "⚡", source: "Native Mach-O Runtime", endpoint: "/api/nomad/state", enabled: true }
    ];
    out.setArray("widgets", widgetsList);

    return jsonSuccess("Dashboard manifest retrieved", out);
}

export function handleUpdateDashboardConfig(ctx: AppRouteContext): AppHttpResponse {
    try {
        let bodyRaw = ctx.request.body;
        if (bodyRaw.trim() == "") {
            return jsonError("Request body required", 400);
        }
        let parsed: any = parseJson(bodyRaw);
        if (parsed["title"] != None) customTitle = String(parsed["title"]);
        if (parsed["defaultCity"] != None) customDefaultCity = String(parsed["defaultCity"]);
        if (parsed["defaultCountry"] != None) customDefaultCountry = String(parsed["defaultCountry"]);
        if (parsed["defaultCrypto"] != None) customDefaultCrypto = String(parsed["defaultCrypto"]);

        let state: AppState = getAppState();
        if (state.client != None) {
            try {
                let db: MongoDatabase = state.client as MongoDatabase;
                let filter: MongoJsonObject = new MongoJsonObject({});
                filter.setString("configKey", "dashboard_main");
                let doc: MongoJsonObject = new MongoJsonObject({});
                doc.setString("title", customTitle);
                doc.setString("defaultCity", customDefaultCity);
                doc.setString("defaultCountry", customDefaultCountry);
                doc.setString("defaultCrypto", customDefaultCrypto);
                db.upsertOne("dashboard_config", filter, doc);
            } catch (dbErr) {
                print("[mongo-err] Failed to persist dashboard config to MongoDB: " + String(dbErr));
            }
        }

        let out: JsonObject = objectOf({});
        out.setString("title", customTitle);
        out.setString("defaultCity", customDefaultCity);
        out.setString("defaultCountry", customDefaultCountry);
        out.setString("defaultCrypto", customDefaultCrypto);
        return jsonSuccess("Dashboard configuration updated successfully", out);
    } catch (e) {
        return jsonError("Failed to update config: " + String(e), 400);
    }
}
