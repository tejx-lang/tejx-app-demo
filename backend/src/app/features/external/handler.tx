// External upstream API integration handler
import { fetch, Response } from "std:http";
import { now } from "std:time";
import { AppRouteContext, AppHttpResponse } from "../../../server/index.tx";
import { jsonSuccess, jsonError } from "../../core/responses.tx";
import { JsonObject, objectOf } from "../../helpers/json.tx";
import { resolveExternalUpstreamUrl } from "../../config/env.tx";

export function handleExternalUpstream(ctx: AppRouteContext): AppHttpResponse {
    let url: string = resolveExternalUpstreamUrl();
    let startedAt: int64 = now();

    let out: JsonObject = objectOf({});
    out.setString("targetUrl", url);

    try {
        let res: Response = fetch(url, { timeoutMs: 5000 });
        let elapsed: int64 = now() - startedAt;

        out.setBool("upstreamAvailable", true);
        out.setInt("statusCode", res.status);
        out.setInt64("latencyMs", elapsed);
        out.setString("body", res.text());
        return jsonSuccess("Upstream API fetch successful", out);
    } catch (err) {
        let elapsed: int64 = now() - startedAt;
        out.setBool("upstreamAvailable", false);
        out.setInt("statusCode", 503);
        out.setInt64("latencyMs", elapsed);
        out.setString("error", String(err));

        let fallbackData: JsonObject = objectOf({});
        fallbackData.setString("title", "Nomad Global Upstream Feed");
        fallbackData.setString("status", "Active (Cached Fallback)");
        fallbackData.setString("category", "Nomad Gear & Connectivity");
        fallbackData.setFloat("rating", 4.95);
        out.setObject("fallback", fallbackData);

        return jsonSuccess("Upstream offline - loaded cached fallback data", out);
    }
}
