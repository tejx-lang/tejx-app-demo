        { "rank": 2, "productId": "mp-anc-ultra", "title": "Nomad ANC Titanium Noise-Cancelling Headphones", "category": "Audio", "unitsSold": 88, "revenue": 17529.60 },
        { "rank": 3, "productId": "mp-gan-200w", "title": "HyperCharge 200W Quad-Port GaN Travel Fast Charger", "category": "Power", "unitsSold": 115, "revenue": 8699.75 },
        { "rank": 4, "productId": "mp-carbon-stand", "title": "AeroCarbon Featherweight Foldable Laptop Stand", "category": "Workstation", "unitsSold": 54, "revenue": 3510.00 }
    ];

    let topCategories: any[] = [
        { "rank": 1, "category": "Connectivity", "gmv": 72299.30, "marketSharePercent": 70.8 },
