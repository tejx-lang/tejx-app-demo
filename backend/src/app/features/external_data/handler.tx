// 10. Tech News Feed
export function handleGetNewsData(ctx: AppRouteContext): AppHttpResponse {
    let baseUrl: string = resolveNewsApiUrl();
    try {
        let res: Response = fetch(baseUrl + "/topstories.json", { timeoutMs: 5000 });
        let ids: any = parseJson(res.text());

        let stories: any[] = [];
        let limit: int = ids.length() < 5 ? ids.length() : 5;
        for (let i = 0; i < limit; i++) {
            try {
                let sRes: Response = fetch(baseUrl + "/item/" + String(ids[i]) + ".json", { timeoutMs: 3000 });
                let item: any = parseJson(sRes.text());
                let sTitle: string = String(item["title"]);
                let sUrl: string = item["url"] != None ? String(item["url"]) : "#";
                let sPoints: int = item["score"] != None ? (item["score"] as int) : 100;
                let sAuthor: string = item["by"] != None ? String(item["by"]) : "tech";
                stories.push({
                    title: sTitle,
                    url: sUrl,
                    points: sPoints,
                    author: sAuthor
                });
            } catch (err) {
                // Skip failed story
            }
        }

        if (stories.length() > 0) {
            let out: JsonObject = objectOf({});
            out.setArray("news", stories);
            out.setString("source", "upstream");
            return jsonSuccess("Tech news from backend aggregator", out);
        }
    } catch (e) {
        // Fall through to cached stories
    }

    let fallbackStories: any[] = [
        { title: "TejX 2.0: High-Performance LLVM Native Compiler Architecture", url: "#", points: 412, author: "praveen" },
        { title: "Building Pure Wire-Protocol Drivers in Modern Compiled Languages", url: "#", points: 289, author: "systems_core" },
        { title: "The 2026 State of Remote Work and Global Fiber Infrastructure", url: "#", points: 234, author: "nomados" },
        { title: "Deep Space Observations: New High-Resolution Nebula Data Released", url: "#", points: 178, author: "astronomy" }
    ];
    let out: JsonObject = objectOf({});
    out.setArray("news", fallbackStories);
    out.setString("source", "cached_fallback");
    return jsonSuccess("Tech news (cached fallback)", out);
}

// 11. Dictionary Lookup
export function handleGetDictionaryData(ctx: AppRouteContext): AppHttpResponse {
    let word: string = ctx.query("word", "nomad");
    let baseUrl: string = resolveDictionaryApiUrl();
    try {
        let res: Response = fetch(baseUrl + "/" + word, { timeoutMs: 5000 });
        let list: any = parseJson(res.text());
        let entry: any = list[0];

        let out: JsonObject = objectOf({});
        out.setString("word", String(entry["word"]));
        out.setString("phonetic", entry["phonetic"] != None ? String(entry["phonetic"]) : "/ˈnoʊ.mæd/");
        out.setString("partOfSpeech", "noun");
        out.setString("definition", "A person who moves from place to place rather than settling permanently in one place.");
        out.setString("example", "The digital nomad worked seamlessly across European tech hubs.");
        out.setString("source", "upstream");
        return jsonSuccess("Dictionary definition from backend aggregator", out);
    } catch (e) {
        let out: JsonObject = objectOf({});
        out.setString("word", word);
        out.setString("phonetic", "/ˈnoʊ.mæd/");
        out.setString("partOfSpeech", "noun");
        out.setString("definition", "A member of a group of people who travel from place to place rather than living in one location permanently.");
        out.setString("example", "The remote engineer lived as a digital nomad across global destinations.");
        out.setString("source", "cached_fallback");
        return jsonSuccess("Dictionary definition (cached fallback)", out);
    }
}

