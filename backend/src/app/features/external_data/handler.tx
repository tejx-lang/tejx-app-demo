// 18. Anime Schedule
export function handleGetAnimeData(ctx: AppRouteContext): AppHttpResponse {
    let animeList: any[] = [
        { title: "Frieren: Beyond Journey's End", score: 9.38, episodes: 28, type: "TV", image: "https://images.unsplash.com/photo-1578632767115-351597cf2477?w=500&auto=format&fit=crop&q=80" },
        { title: "Fullmetal Alchemist: Brotherhood", score: 9.10, episodes: 64, type: "TV", image: "https://images.unsplash.com/photo-1534447677768-be436bb09401?w=500&auto=format&fit=crop&q=80" },
        { title: "Steins;Gate", score: 9.07, episodes: 24, type: "TV", image: "https://images.unsplash.com/photo-1563089145-599997674d42?w=500&auto=format&fit=crop&q=80" }
    ];
    let out: JsonObject = objectOf({});
    out.setArray("anime", animeList);
    return jsonSuccess("Top anime schedule from backend", out);
}

// 19. Pet Stress Relief
export function handleGetPetsData(ctx: AppRouteContext): AppHttpResponse {
    let baseUrl: string = resolveDogApiUrl();
    try {
        let res: Response = fetch(baseUrl, { timeoutMs: 5000 });
        let d: any = parseJson(res.text());

        let out: JsonObject = objectOf({});
        out.setString("type", "dog");
        out.setString("url", String(d["message"]));
        out.setString("caption", "Instant Dopamine Boost! 🐾");
        out.setString("source", "upstream");
        return jsonSuccess("Pet relief photo from backend aggregator", out);
    } catch (e) {
        let out: JsonObject = objectOf({});
        out.setString("type", "dog");
        out.setString("url", "https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=600&auto=format&fit=crop&q=80");
        out.setString("caption", "Happy Golden Explorer 🐶");
        out.setString("source", "cached_fallback");
        return jsonSuccess("Pet relief photo (cached fallback)", out);
    }
}

// 20. Video Game Lore
export function handleGetGamingData(ctx: AppRouteContext): AppHttpResponse {
    let gamingList: any[] = [
        { title: "Cyberpunk 2077: Phantom Liberty", genre: "Open World RPG", platform: "PC / PS5 / Xbox", score: "92/100", status: "Available" },
        { title: "Starfield: Shattered Space", genre: "Space Exploration", platform: "PC / Xbox", score: "86/100", status: "Available" },
        { title: "Elden Ring: Shadow of the Erdtree", genre: "Action RPG", platform: "Multi-platform", score: "95/100", status: "Available" },
        { title: "Hades II", genre: "Roguelike Dungeon", platform: "PC / Early Access", score: "94/100", status: "Early Access" }
    ];
    let out: JsonObject = objectOf({});
    out.setArray("games", gamingList);
    return jsonSuccess("Gaming radar from backend", out);
}
