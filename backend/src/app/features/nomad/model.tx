// Nomad Hub user preferences & notes model
import { JsonObject, objectOf } from "../../helpers/json.tx";

export class NomadNote {
    id: string;
    title: string;
    content: string;
    category: string;
    createdAt: int64;

    constructor(id: string, title: string, content: string, category: string, createdAt: int64) {
        this.id = id;
        this.title = title;
        this.content = content;
        this.category = category;
        this.createdAt = createdAt;
    }

    toJSON(): any {
        return {
            "id": this.id,
            "title": this.title,
            "content": this.content,
            "category": this.category,
            "createdAt": this.createdAt
        };
    }
}

export class NomadBookmark {
    id: string;
    type: string; // "country", "crypto", "stock", "recipe", "quote"
    title: string;
    data: string; // JSON payload
    createdAt: int64;

    constructor(id: string, type: string, title: string, data: string, createdAt: int64) {
        this.id = id;
        this.type = type;
        this.title = title;
        this.data = data;
        this.createdAt = createdAt;
    }

    toJSON(): any {
        return {
            "id": this.id,
            "type": this.type,
            "title": this.title,
            "data": this.data,
            "createdAt": this.createdAt
        };
    }
}
