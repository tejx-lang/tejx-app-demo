// User domain model
import { JsonObject, objectOf } from "../../helpers/json.tx";

export class AppUser {
    id: string;
    name: string;
    email: string;
    role: string;
    createdAt: int64;

    constructor(id: string, name: string, email: string, role: string, createdAt: int64) {
        this.id = id;
        this.name = name;
        this.email = email;
        this.role = role;
        this.createdAt = createdAt;
    }

    toJSON(): any {
        return {
            "id": this.id,
            "name": this.name,
            "email": this.email,
            "role": this.role,
            "createdAt": this.createdAt
        };
    }
}
