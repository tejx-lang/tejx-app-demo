// Store and persistence coordinator with real MongoDB collection integration
import { now } from "std:time";
import { MongoDatabase } from "../../../../mongo-sdk/src/index.tx";
import { MongoJsonObject, objectOf } from "../../../../mongo-sdk/src/json.tx";
import { AppState, getAppState } from "./state.tx";
import { nextEntityId } from "./ids.tx";
import { AppUser } from "../features/users/model.tx";
import { AppProduct } from "../features/products/model.tx";
import { AppOrder } from "../features/orders/model.tx";
import { AppEvent } from "../features/events/model.tx";
import { NomadNote, NomadBookmark } from "../features/nomad/model.tx";

export function recordAppEvent(action: string, entity: string, entityId: string): void {
    let state: AppState = getAppState();
    let eventId: string = nextEntityId("ev", state.events.ids);
    let event: AppEvent = new AppEvent(eventId, action, entity, entityId, now());
    state.events.add(eventId, event);

    if (state.client != None) {
        try {
            let db: MongoDatabase = state.client as MongoDatabase;
            let doc: MongoJsonObject = new MongoJsonObject({});
            doc.setString("id", event.id);
            doc.setString("action", event.action);
            doc.setString("entity", event.entity);
            doc.setString("entityId", event.entityId);
            doc.setInt("timestamp", event.timestamp as int);
            db.insertOne("events", doc);
        } catch (e) {
            // Keep going if write fails
        }
    }
}

export function persistNomadNote(note: NomadNote): void {
    let state: AppState = getAppState();
    if (state.client != None) {
        try {
            let db: MongoDatabase = state.client as MongoDatabase;
            let doc: MongoJsonObject = new MongoJsonObject({});
            doc.setString("id", note.id);
            doc.setString("title", note.title);
            doc.setString("content", note.content);
            doc.setString("category", note.category);
            doc.setInt("createdAt", note.createdAt as int);
            db.insertOne("nomad_notes", doc);
        } catch (e) {
            print("[mongo-err] Failed to persist note to MongoDB: " + String(e));
        }
    }
}

export function deleteNomadNoteFromDb(id: string): void {
    let state: AppState = getAppState();
    if (state.client != None) {
        try {
            let db: MongoDatabase = state.client as MongoDatabase;
            let filter: MongoJsonObject = new MongoJsonObject({});
            filter.setString("id", id);
            db.deleteOne("nomad_notes", filter);
        } catch (e) {
            print("[mongo-err] Failed to delete note from MongoDB: " + String(e));
        }
    }
}

