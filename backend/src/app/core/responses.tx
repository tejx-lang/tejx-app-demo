// Standardized JSON response helpers
import { AppHttpResponse, createAppJsonResponse } from "../../server/index.tx";
import { JsonObject, objectOf, plainJson } from "../helpers/json.tx";

export function jsonResponse(data: JsonObject, status: int = 200): AppHttpResponse {
    return createAppJsonResponse(plainJson(data), status);
}

export function jsonSuccess(message: string, extra: Optional<JsonObject> = None): AppHttpResponse {
    let out: JsonObject = objectOf({});
    out.setBool("success", true);
    out.setString("message", message);
    if (extra != None) {
        let ext = extra as JsonObject;
        let keys = Object.keys(ext.values);
        for (let i = 0; i < keys.length(); i++) {
            out.values[keys[i]] = ext.values[keys[i]];
        }
        out.values["data"] = ext.values;
    }
    return jsonResponse(out, 200);
}

export function jsonError(message: string, status: int = 400): AppHttpResponse {
    let out: JsonObject = objectOf({});
    out.setBool("success", false);
    out.setString("error", message);
    return jsonResponse(out, status);
}

export function jsonNotFound(message: string = "Resource not found"): AppHttpResponse {
    return jsonError(message, 404);
}
