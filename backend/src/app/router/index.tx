// Central API Router
import { AppHttpRouter, AppHttpResponse, AppRouteContext } from "../../server/index.tx";
import { jsonSuccess } from "../core/responses.tx";
import { JsonObject, objectOf } from "../helpers/json.tx";
import { getStorageMode } from "../core/persistence.tx";
import { now } from "std:time";

import {
    handleListUsers,
    handleGetUser,
    handleCreateUser,
    handleUpdateUser,
    handleDeleteUser,
    handlePatchUser
} from "../features/users/handler.tx";

import {
    handleListProducts,
    handleGetProduct,
    handleCreateProduct,
    handleUpdateProduct,
    handleDeleteProduct,
    handlePatchProduct
} from "../features/products/handler.tx";

import {
    handleGetMongoOperations,
    handleExecuteMongoOperation,
    handleOptionsMongoOperations
} from "../features/database/operations.tx";

import {
    handleListOrders,
    handleGetOrder,
    handleCreateOrder,
    handleUpdateOrder,
    handleDeleteOrder
} from "../features/orders/handler.tx";

import {
    handleGetNomadState,
    handleCreateNomadNote,
    handleDeleteNomadNote,
    handleCreateNomadBookmark,
    handleDeleteNomadBookmark
} from "../features/nomad/handler.tx";

import { handleListEvents } from "../features/events/handler.tx";
import { handleGetSummaryReport } from "../features/reports/handler.tx";
import { handleSearch } from "../features/search/handler.tx";
import { handleExternalUpstream } from "../features/external/handler.tx";

import {
    handleGetDashboardConfig,
    handleUpdateDashboardConfig
} from "../features/dashboard/handler.tx";

import {
    handleDatabaseStatus,
    handleDatabaseReconnect
} from "../features/database/handler.tx";

import {
    handleGetWeatherData,
    handleGetAirQualityData,
    handleGetGeolocationData,
    handleGetCountryData,
    handleGetExchangeData,
    handleGetHolidaysData,
    handleGetCryptoData,
    handleGetStocksData,
    handleGetSentimentData,
    handleGetNewsData,
    handleGetDictionaryData,
    handleGetActivityData,
    handleGetRecipeData,
    handleGetNasaApodData,
    handleGetQuotesData,
    handleGetShowsData,
    handleGetPokemonData,
    handleGetAnimeData,
    handleGetPetsData,
    handleGetGamingData
} from "../features/external_data/handler.tx";

function handleWelcome(ctx: AppRouteContext): AppHttpResponse {
    let out: JsonObject = objectOf({});
    out.setString("name", "TejX Digital Nomad Super-App API");
    out.setString("version", "2.0.0");
    out.setString("engine", "TejX Production Compiler (LLVM Native)");
    out.setString("storage", getStorageMode());
    return jsonSuccess("Welcome to TejX API", out);
}

function handleHealth(ctx: AppRouteContext): AppHttpResponse {
    let out: JsonObject = objectOf({});
    out.setString("status", "healthy");
    out.setString("storageMode", getStorageMode());
    out.setInt64("timestamp", now());
    return jsonSuccess("System healthy", out);
}

export function createAppRouter(): AppHttpRouter {
    let router: AppHttpRouter = new AppHttpRouter();

    // System routes
    router.get("/", handleWelcome);
    router.get("/health", handleHealth);
    router.get("/api/external", handleExternalUpstream);

    // Database diagnostics, operations workbench and reconnect
    router.get("/api/database/status", handleDatabaseStatus);
    router.post("/api/database/reconnect", handleDatabaseReconnect);
    router.get("/api/database/operations", handleGetMongoOperations);
    router.post("/api/database/operations", handleExecuteMongoOperation);
    router.options("/api/database/operations", handleOptionsMongoOperations);

    // Backend-driven dynamic dashboard configuration
    router.get("/api/dashboard/config", handleGetDashboardConfig);
    router.post("/api/dashboard/config", handleUpdateDashboardConfig);

    // Backend-aggregated external data endpoints (shielding frontend from external servers)
    router.get("/api/data/weather", handleGetWeatherData);
    router.get("/api/data/air-quality", handleGetAirQualityData);
    router.get("/api/data/geolocation", handleGetGeolocationData);
    router.get("/api/data/country", handleGetCountryData);
    router.get("/api/data/forex", handleGetExchangeData);
    router.get("/api/data/holidays", handleGetHolidaysData);
    router.get("/api/data/crypto", handleGetCryptoData);
    router.get("/api/data/stocks", handleGetStocksData);
    router.get("/api/data/sentiment", handleGetSentimentData);
    router.get("/api/data/news", handleGetNewsData);
    router.get("/api/data/dictionary", handleGetDictionaryData);
    router.get("/api/data/activity", handleGetActivityData);
    router.get("/api/data/recipe", handleGetRecipeData);
    router.get("/api/data/apod", handleGetNasaApodData);
    router.get("/api/data/quotes", handleGetQuotesData);
    router.get("/api/data/shows", handleGetShowsData);
    router.get("/api/data/pokemon", handleGetPokemonData);
    router.get("/api/data/anime", handleGetAnimeData);
    router.get("/api/data/pets", handleGetPetsData);
    router.get("/api/data/gaming", handleGetGamingData);

    // Analytics & search
    router.get("/api/reports/summary", handleGetSummaryReport);
    router.get("/api/search", handleSearch);
    router.get("/api/events", handleListEvents);

    // Users CRUD
    router.get("/api/users", handleListUsers);
    router.post("/api/users", handleCreateUser);
    router.get("/api/users/:userId", handleGetUser);
    router.put("/api/users/:userId", handleUpdateUser);
    router.patch("/api/users/:userId", handlePatchUser);
    router.deleteRoute("/api/users/:userId", handleDeleteUser);

    // Products CRUD
    router.get("/api/products", handleListProducts);
    router.post("/api/products", handleCreateProduct);
    router.get("/api/products/:productId", handleGetProduct);
    router.put("/api/products/:productId", handleUpdateProduct);
    router.patch("/api/products/:productId", handlePatchProduct);
    router.deleteRoute("/api/products/:productId", handleDeleteProduct);

    // Orders CRUD
    router.get("/api/orders", handleListOrders);
    router.post("/api/orders", handleCreateOrder);
    router.get("/api/orders/:orderId", handleGetOrder);
    router.put("/api/orders/:orderId", handleUpdateOrder);
    router.deleteRoute("/api/orders/:orderId", handleDeleteOrder);

    // Nomad Hub Preferences & Notes
    router.get("/api/nomad/state", handleGetNomadState);
    router.post("/api/nomad/notes", handleCreateNomadNote);
    router.deleteRoute("/api/nomad/notes/:noteId", handleDeleteNomadNote);
    router.post("/api/nomad/bookmarks", handleCreateNomadBookmark);
    router.deleteRoute("/api/nomad/bookmarks/:bookmarkId", handleDeleteNomadBookmark);

    return router;
}
