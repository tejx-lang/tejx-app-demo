// Environment configuration loader with .env file support
import { getEnv } from "std:system";
import { exists, readFile } from "std:fs";
import { Map } from "std:collections";

let envMap: Map<string, string> = new Map<string, string>();
let envLoaded: bool = false;

function cleanQuote(val: string): string {
    let s: string = val.trim();
    if (s.length() >= 2) {
        if ((s.startsWith("\"") && s.endsWith("\"")) || (s.startsWith("'") && s.endsWith("'"))) {
            return s.substring(1, s.length() - 1);
        }
    }
    return s;
}

function parseEnvContent(content: string): void {
    let lines: string[] = content.split("\n");
    for (let i: int = 0; i < lines.length(); i++) {
        let line: string = lines[i].trim();
        if (line == "" || line.startsWith("#")) {
            continue;
        }
        let eq: int = line.indexOf("=");
        if (eq > 0) {
            let key: string = line.substring(0, eq).trim();
            let val: string = cleanQuote(line.substring(eq + 1, line.length()));
            envMap.set(key, val);
        }
    }
}

export function loadEnvFiles(): void {
    if (envLoaded) {
        return;
    }
    envLoaded = true;

    let candidatePaths: string[] = [
        "backend/.env",
        ".env",
        "../backend/.env"
    ];

    for (let i: int = 0; i < candidatePaths.length(); i++) {
        let p: string = candidatePaths[i];
        if (exists(p)) {
            try {
                let content: string = readFile(p);
                parseEnvContent(content);
                break;
            } catch (err) {
                // Ignore read error and try next
            }
        }
    }
}

export function getConfig(key: string, fallback: string = ""): string {
    loadEnvFiles();

    // 1. Process environment variable has top priority
    let sysVal: Optional<string> = getEnv(key);
    if (sysVal != None && (sysVal as string) != "") {
        return sysVal as string;
    }

    // 2. .env file configuration
    let fileVal: Optional<string> = envMap.get(key);
    if (fileVal != None && (fileVal as string) != "") {
        return fileVal as string;
    }

    return fallback;
}

export function resolvePort(): string {
    return getConfig("PORT", "8080");
}

export function resolveHost(): string {
    return getConfig("HOST", "127.0.0.1");
}

export function resolveMongoUri(): string {
    return getConfig("MONGO_URI", "mongodb://root:password@127.0.0.1:27017/tejx_marketplace_db?authSource=admin");
}

// Seeded administrator credentials. These defaults preserve the local-demo
// experience when no backend/.env file has been created yet.
export function resolveAdminUsername(): string {
    let username: string = getConfig("ADMIN_USERNAME", "");
    let password: string = getConfig("ADMIN_PASSWORD", "");
    if (username != "" && password != "") return username;
    return "admin";
}

export function resolveAdminPassword(): string {
    let username: string = getConfig("ADMIN_USERNAME", "");
    let password: string = getConfig("ADMIN_PASSWORD", "");
    if (username != "" && password != "") return password;
    return "admin";
}

