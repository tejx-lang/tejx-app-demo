# ==========================================
# TejX Backend Environment Configuration (Template)
# ==========================================

PORT=8080

# Initial root administrator. Omit either setting to use the local-demo
# fallback of admin/admin. Keep production values in backend/.env, never in
# frontend environment files.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# MongoDB Connection URI (e.g. mongodb://user:pass@host:port/database?authSource=admin)
MONGO_URI=mongodb://127.0.0.1:27017/tejx_nomad_db

# ==========================================
# External Public APIs Aggregated by Backend
# ==========================================
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
AIR_QUALITY_API_URL=https://air-quality-api.open-meteo.com/v1/air-quality
GEOLOCATION_API_URL=https://ipapi.co/json
COUNTRIES_API_URL=https://restcountries.com/v3.1
TIME_API_URL=https://timeapi.io/api/time/current/zone
HOLIDAYS_API_URL=https://date.nager.at/api/v3
CRYPTO_API_URL=https://api.coingecko.com/api/v3
EXCHANGE_API_URL=https://api.frankfurter.app/latest
DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en
BORED_API_URL=https://bored-api.appbrewery.com/random
QR_API_URL=https://api.qrserver.com/v1/create-qr-code
NEWS_API_URL=https://hacker-news.firebaseio.com/v0
RECIPE_API_URL=https://www.themealdb.com/api/json/v1/1
NASA_API_URL=https://api.nasa.gov/planetary/apod
QUOTES_API_URL=https://zenquotes.io/api/random
SHOWS_API_URL=https://api.tvmaze.com
POKE_API_URL=https://pokeapi.co/api/v2
ANIME_API_URL=https://api.jikan.moe/v4
DOG_API_URL=https://dog.ceo/api/breeds/image/random
